# ==============================================
# CampusChronicle - Environment Variables Template
# ==============================================
# Copy this file to .env.local and populate the values.
# NEVER commit .env or .env.local to version control!

# ----------------------------------------------
# Supabase Configuration
# ----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-for-server-admin-only"

# ----------------------------------------------
# Cloudinary Configuration (Media Storage & CDN)
# ----------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ----------------------------------------------
# Application URL / Domain
# ----------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
